#!/usr/bin/python3
"""sudo with the phone or the password, whichever comes first.

For PAM, as
    auth sufficient pam_exec.so quiet quiet_log /usr/local/bin/pshell-pam-phone
in /etc/pam.d/sudo (system/install-phone-sudo.sh puts it there). It asks the
user's phone daemon for a fingerprint and, on the terminal, for the password
at the same time. A finger on the phone, or the right password (checked with
unix_chkpwd), is a yes: exit 0. A wrong password, or no answer, lets the next
module (pam_unix, the password again) have its turn. Whatever ends it, the
request on the phone is taken back.
"""

import json
import os
import pwd
import secrets
import select
import subprocess
import sys
import termios

REPO = os.path.dirname(os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
PHONECTL = os.path.join(REPO, "scripts", "phone", "phonectl")
CHKPWD = next((p for p in ("/usr/bin/unix_chkpwd", "/usr/sbin/unix_chkpwd", "/sbin/unix_chkpwd") if os.path.exists(p)), None)


def main():
    user = os.environ.get("PAM_USER") or pwd.getpwuid(os.getuid()).pw_name
    try:
        account = pwd.getpwnam(user)
    except KeyError:
        return 1
    runtime = f"/run/user/{account.pw_uid}"
    if not os.path.exists(f"{runtime}/pshell/phone.sock"):
        return 1
    try:
        host = open("/etc/hostname").read().strip() or os.uname().nodename
    except OSError:
        host = os.uname().nodename
    service = os.environ.get("PAM_SERVICE", "sudo")

    command = ["/usr/bin/python3", PHONECTL, "call", "unlock", "pam", json.dumps({"id": secrets.token_hex(4), "what": f"{service} on {host}", "timeout": 45}), "--timeout", "50"]
    if os.getuid() == 0 and account.pw_uid != 0:
        # the daemon's socket belongs to the user; asked as the user
        command = ["runuser", "-u", user, "--", "env", f"XDG_RUNTIME_DIR={runtime}", f"HOME={account.pw_dir}"] + command
    else:
        os.environ["XDG_RUNTIME_DIR"] = runtime
    phone = subprocess.Popen(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    tty = os.environ.get("PAM_TTY", "")
    if tty and not tty.startswith("/dev/"):
        tty = "/dev/" + tty
    if not tty or not os.path.exists(tty) or CHKPWD is None:
        # no terminal to type into: the phone alone
        return 0 if phone.wait() == 0 else 1

    fd = os.open(tty, os.O_RDWR | os.O_NOCTTY)
    old = termios.tcgetattr(fd)
    quiet = termios.tcgetattr(fd)
    quiet[3] &= ~(termios.ECHO | termios.ICANON)
    termios.tcsetattr(fd, termios.TCSANOW, quiet)
    os.write(fd, f"[{service}] password for {user}, or a finger on the phone: ".encode())
    typed = b""
    try:
        while True:
            ready, _, _ = select.select([fd], [], [], 0.2)
            if phone.poll() is not None and phone.returncode == 0:
                os.write(fd, b"\r\n")
                return 0
            if not ready:
                continue
            char = os.read(fd, 1)
            if not char or char in (b"\r", b"\n"):
                break
            if char == b"\x03":  # ^C
                return 1
            if char in (b"\x7f", b"\x08"):
                typed = typed[:-1]
            elif char == b"\x15":  # ^U
                typed = b""
            else:
                typed += char
        os.write(fd, b"\r\n")
        check = subprocess.run([CHKPWD, user, "nonull"], input=typed + b"\0", stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        return 0 if check.returncode == 0 else 1
    finally:
        termios.tcsetattr(fd, termios.TCSANOW, old)
        os.close(fd)
        # whoever asked is gone: the daemon takes the request off the phone
        if phone.poll() is None:
            phone.terminate()


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception:
        sys.exit(1)
