    days_parser.add_argument("--json", action="store_true")

    return parser.parse_args()


def day_entry_selector_from_args(args: argparse.Namespace) -> dict[str, Any]:
    entry_number = getattr(args, "entry", None)
    project = getattr(args, "project", None)
    description = getattr(args, "description", None)

    if entry_number is not None:
        if project or description:
            raise TrackerError("Use either an entry number or --project/--description, not both.")
        return {"entry_number": entry_number}

    if project and description:
        return {"project": project, "description": description}

    raise TrackerError("Provide either an entry number or both --project and --description.")


def try_export_obsidian_day(day_value: str | None) -> None:
    if not OBSIDIAN_DAY_EXPORTER.exists():
        return

    _, _, target_day = day_bounds(day_value)

    try:
        subprocess.run(
            [sys.executable, str(OBSIDIAN_DAY_EXPORTER), "--day", format_date_label(target_day)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            check=False,
            timeout=10,
        )
    except OSError:
        return
    except subprocess.TimeoutExpired:
        return


def main() -> int:
    args = parse_args()
    current_timestamp = now_ts()
    store: TrackerStore | None = None

    try:
        if args.command == "teamwork-tasks":
            entries = TeamworkClient().relevant_tasks()
            payload = {
                "ok": True,
                "base_url": teamwork_base_url(),
                "entries": entries,
                "task_count": len(entries),
            }
            if args.json:
                print(json.dumps(payload, ensure_ascii=True))
            else:
                for entry in entries:
                    print(entry["label"])
            return 0

        store = TrackerStore(resolve_db_path())

        if args.command == "start":
            payload = store.start(
                args.project,
                args.description,
                current_timestamp,
                teamwork_task_id=args.teamwork_task_id,
                teamwork_project_id=args.teamwork_project_id,
                teamwork_task_name=args.teamwork_task_name,
                teamwork_project_name=args.teamwork_project_name,
                teamwork_task_url=args.teamwork_task_url,
            )
            try_export_obsidian_day("today")
            print(payload["message"])
