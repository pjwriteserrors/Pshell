    def today_started_tasks(
        self,
        day_value: str | None,
        entry_lookup: dict[tuple[str, str], dict[str, Any]] | None = None,
    ) -> list[dict[str, Any]]:
        day_start_ts, day_end_ts, _ = day_bounds(day_value)

        rows = self.connection.execute(
            """
            SELECT
                project,
                description,
                teamwork_task_id,
                teamwork_project_id,
                teamwork_task_name,
                teamwork_project_name,
                teamwork_task_url,
                MIN(started_ts) AS first_started_ts,
                MAX(started_ts) AS last_started_ts
            FROM sessions
            WHERE started_ts >= ?
              AND started_ts < ?
            GROUP BY project, description, teamwork_task_id, teamwork_project_id
            ORDER BY last_started_ts DESC, project COLLATE NOCASE ASC, description COLLATE NOCASE ASC
            """
            ,
            (day_start_ts, day_end_ts),
        ).fetchall()

        tasks: list[dict[str, Any]] = []

        for row in rows:
            project = str(row["project"])
            description = str(row["description"])
            entry = (entry_lookup or {}).get(entry_key(project, description), {})
            rounded_range_label = str(entry.get("rounded_range_label") or "")
            tracking_label = str(entry.get("tracking_label") or "")

            tasks.append(
                {
                    "project": project,
                    "description": description,
                    "teamwork_task_id": parse_optional_int(row["teamwork_task_id"]),
                    "teamwork_project_id": parse_optional_int(row["teamwork_project_id"]),
                    "teamwork_task_name": str(row["teamwork_task_name"] or ""),
                    "teamwork_project_name": str(row["teamwork_project_name"] or ""),
                    "teamwork_task_url": str(row["teamwork_task_url"] or ""),
                    "first_started_ts": int(row["first_started_ts"]),
                    "first_started_label": format_time_label(int(row["first_started_ts"])),
                    "last_started_ts": int(row["last_started_ts"]),
                    "last_started_label": format_time_label(int(row["last_started_ts"])),
                    "rounded_range_label": rounded_range_label,
                    "tracking_label": tracking_label,
                    "label": f"{format_time_label(int(row['last_started_ts']))}  ·  {project}  ·  {description}",
                }
            )

        return tasks

    def day_entries(self, day_value: str | None, current_timestamp: int) -> dict[str, Any]:
        day_start_ts, day_end_ts, target_day = day_bounds(day_value)
        day_label = format_date_label(target_day)

        rows = self.connection.execute(
            """
            SELECT
                sessions.project,
                sessions.description,
                sessions.teamwork_task_id,
                sessions.teamwork_project_id,
                sessions.teamwork_task_name,
                sessions.teamwork_project_name,
                sessions.teamwork_task_url,
                sessions.teamwork_billable,
                sessions.state,
                segments.started_ts,
                segments.ended_ts AS raw_ended_ts,
                COALESCE(segments.ended_ts, ?) AS ended_ts
            FROM segments
            JOIN sessions ON sessions.id = segments.session_id
            WHERE segments.started_ts < ?
              AND COALESCE(segments.ended_ts, ?) > ?
            ORDER BY segments.started_ts ASC, segments.id ASC
            """,
            (current_timestamp, day_end_ts, current_timestamp, day_start_ts),
        ).fetchall()

        total_seconds = 0
        grouped: "OrderedDict[tuple[str, str], dict[str, Any]]" = OrderedDict()

        for row in rows:
            clipped_start = max(day_start_ts, int(row["started_ts"]))
            clipped_end = min(day_end_ts, int(row["ended_ts"]))
            if clipped_end <= clipped_start:
                continue

            duration_seconds = clipped_end - clipped_start
            total_seconds += duration_seconds

            key = (str(row["project"]), str(row["description"]))
            if key not in grouped:
                grouped[key] = {
                    "project": key[0],
                    "description": key[1],
                    "teamwork_task_id": parse_optional_int(row["teamwork_task_id"]),
                    "teamwork_project_id": parse_optional_int(row["teamwork_project_id"]),
                    "teamwork_task_name": str(row["teamwork_task_name"] or ""),
                    "teamwork_project_name": str(row["teamwork_project_name"] or ""),
                    "teamwork_task_url": str(row["teamwork_task_url"] or ""),
                    "teamwork_billable": bool(int(row["teamwork_billable"] if row["teamwork_billable"] is not None else 1)),
                    "duration_seconds": 0,
                    "ranges": [],
                    "segments": [],
                    "first_started_ts": clipped_start,
                    "last_ended_ts": clipped_end,
                    "last_completed_ended_ts": 0,
                    "is_running": False,
                }

            group = grouped[key]
            group["duration_seconds"] += duration_seconds
            const_range = format_range_label(clipped_start, clipped_end)
            if const_range not in group["ranges"]:
                group["ranges"].append(const_range)
            if group.get("teamwork_task_id") is None:
                group["teamwork_task_id"] = parse_optional_int(row["teamwork_task_id"])
                group["teamwork_project_id"] = parse_optional_int(row["teamwork_project_id"])
                group["teamwork_task_name"] = str(row["teamwork_task_name"] or "")
                group["teamwork_project_name"] = str(row["teamwork_project_name"] or "")
                group["teamwork_task_url"] = str(row["teamwork_task_url"] or "")
            if int(row["teamwork_billable"] if row["teamwork_billable"] is not None else 1) == 0:
                group["teamwork_billable"] = False
            group["segments"].append(
                {
                    "started_ts": clipped_start,
                    "ended_ts": clipped_end,
                    "duration_seconds": duration_seconds,
                    "is_running": row["raw_ended_ts"] is None and str(row["state"]) == "active",
                }
            )
            group["first_started_ts"] = min(group["first_started_ts"], clipped_start)
            group["last_ended_ts"] = max(group["last_ended_ts"], clipped_end)
            if row["raw_ended_ts"] is not None:
                group["last_completed_ended_ts"] = max(
                    int(group.get("last_completed_ended_ts") or 0),
                    clipped_end,
                )
            if row["raw_ended_ts"] is None and str(row["state"]) == "active":
                group["is_running"] = True

        grouped_entries = []
        checked_rows = self.checked_day_entry_timestamps(day_label)
        for entry in grouped.values():
            checked_ts = int(
                checked_rows.get(entry_key(str(entry["project"]), str(entry["description"])), 0)
            )
            check_target_ts = int(entry.get("last_completed_ended_ts") or entry["last_ended_ts"])
            is_checked = checked_ts >= check_target_ts
            was_checked = checked_ts > 0
            grouped_entries.append(
                {
                    **entry,
                    "checked": is_checked,
                    "checked_ts": checked_ts,
                    "check_target_ts": check_target_ts,
                    "checked_once": was_checked,
                    "stale_checked": was_checked and not is_checked,
                    "checkbox": "[x]" if is_checked else "[ ]",
                    "duration_label": format_duration(entry["duration_seconds"], include_seconds=False),
                    "range_label": ", ".join(entry["ranges"]),
                    "first_started_label": format_time_label(entry["first_started_ts"]),
                    "last_ended_label": format_time_label(entry["last_ended_ts"]),
                }
            )

        apply_rounded_tracking_fields(grouped_entries)
        self.apply_day_entry_time_offsets(day_label, grouped_entries, current_timestamp)
        self.apply_teamwork_sync_fields(day_label, grouped_entries)
        project_groups = build_project_groups(grouped_entries)
        ordered_entries: list[dict[str, Any]] = []
        next_entry_number = 1

        for project_group in project_groups:
            for entry in project_group["entries"]:
                entry["entry_number"] = next_entry_number
                ordered_entries.append(entry)
                next_entry_number += 1

        checked_count = sum(1 for entry in ordered_entries if entry["checked"])

        return {
            "day": day_label,
            "total_seconds": total_seconds,
            "total_label": format_duration(total_seconds, include_seconds=False),
            "project_count": len(project_groups),
            "task_count": len(ordered_entries),
            "checked_count": checked_count,
            "open_count": len(ordered_entries) - checked_count,
            "entries": ordered_entries,
            "project_groups": project_groups,
        }

    def tracked_days(self, current_timestamp: int) -> dict[str, Any]:
        rows = self.connection.execute(
            """
            SELECT started_ts, COALESCE(ended_ts, ?) AS ended_ts
            FROM segments
            """,
            (current_timestamp,),
        ).fetchall()

        today = datetime.fromtimestamp(current_timestamp, tz=LOCAL_TZ).date()
        found: set[date] = {today}
        for row in rows:
            started_ts = int(row["started_ts"])
            current = datetime.fromtimestamp(started_ts, tz=LOCAL_TZ).date()
            last = datetime.fromtimestamp(max(started_ts, int(row["ended_ts"]) - 1), tz=LOCAL_TZ).date()
            while current <= last:
                found.add(current)
                current += timedelta(days=1)

        days: list[dict[str, Any]] = []
        for target in sorted(found, reverse=True):
            payload = self.day_entries(format_date_label(target), current_timestamp)
            entries = payload["entries"]
            if not entries and target != today:
                continue
            sent = sum(1 for entry in entries if entry.get("teamwork_synced"))
            days.append(
                {
                    "day": payload["day"],
                    "total_seconds": payload["total_seconds"],
                    "tracking_minutes": sum(int(entry.get("tracking_minutes") or 0) for entry in entries),
                    "task_count": len(entries),
                    "project_count": payload["project_count"],
                    "queued_count": sum(
                        1 for entry in entries if entry.get("checked") and not entry.get("teamwork_synced")
                    ),
                    "sent_count": sent,
                    "unsent_count": len(entries) - sent,
                }
            )

        return {"ok": True, "today": format_date_label(today), "days": days}

    def status_payload(self, current_timestamp: int) -> dict[str, Any]:
        current = self.session_snapshot(self.current_session_row(), current_timestamp)
        latest = self.session_snapshot(self.latest_session_row(), current_timestamp)

        return {
            "now_ts": current_timestamp,
            "state": current.state if current else "idle",
            "tracking": bool(current and current.is_active),
            "paused": bool(current and current.is_paused),
            "can_resume": bool(current and current.is_paused),
            "session": current.to_dict() if current else None,
            "last_session": latest.to_dict() if latest else None,
            "status_message": (
                "Tracking"
                if current and current.is_active
                else "Paused"
                if current and current.is_paused
                else "Idle"
            ),
        }

    def snapshot_payload(self, day_value: str | None, current_timestamp: int) -> dict[str, Any]:
        payload = self.status_payload(current_timestamp)
        selected_day = day_value or "today"
        today_payload = self.day_entries(selected_day, current_timestamp)
        payload["today"] = today_payload
        payload["today_tasks"] = self.today_started_tasks(
            selected_day,
            {
                entry_key(str(entry["project"]), str(entry["description"])): entry
                for entry in today_payload["entries"]
            },
        )
        return payload


def print_status(payload: dict[str, Any]) -> None:
    session = payload.get("session")
    today = payload.get("today")
    lines = []

    if session:
        lines.append(f"{payload['status_message']}  {session['duration_clock']}")
        lines.append(f"Project: {session['project']}")
        lines.append(f"What:    {session['description']}")
        lines.append(f"Since:   {session['started_label']}")
    else:
        lines.append("Idle")

    if today:
        lines.append(
            f"Today:   {today['total_label']} across {today['task_count']} tasks in {today.get('project_count', 0)} projects"
        )

    print("\n".join(lines))


def render_report(payload: dict[str, Any], *, color_mode: str) -> str:
    enabled = color_enabled(color_mode)
    today = payload["today"]
    session = payload.get("session")
    entries = list(today["entries"])
    project_groups = list(today.get("project_groups") or build_project_groups(entries))

    term_width = terminal_width()
    index_width = 3
    checked_width = 4
    duration_width = 8
    time_width = 22
    description_width = max(18, min(54, term_width - 45))
    widths = [index_width, checked_width, duration_width, description_width, time_width]

    title = style("QTRACK TODAY", "1", "96", enabled=enabled)
    date_label = style(today["day"], "1", enabled=enabled)
    muted_rule = style("=" * min(96, max(64, sum(widths) + 14)), "90", enabled=enabled)
    summary_total = style(today["total_label"], "1", "32", enabled=enabled)
    summary_projects = style(str(today.get("project_count", len(project_groups))), "1", "35", enabled=enabled)
    summary_tasks = style(str(today["task_count"]), "1", "33", enabled=enabled)
    summary_checked = style(str(today.get("checked_count", 0)), "1", "32", enabled=enabled)
    summary_open = style(str(today.get("open_count", 0)), "1", "31", enabled=enabled)

    lines = [
        f"{title}  {date_label}",
        muted_rule,
        f"{style('Total', '1', '36', enabled=enabled)} {summary_total}   "
        f"{style('Projects', '1', '36', enabled=enabled)} {summary_projects}   "
        f"{style('Tasks', '1', '36', enabled=enabled)} {summary_tasks}   "
        f"{style('Done', '1', '36', enabled=enabled)} {summary_checked}   "
        f"{style('Open', '1', '36', enabled=enabled)} {summary_open}",
    ]

    if session:
        state_text = payload["status_message"].upper()
        state_color = "32" if payload["status_message"] == "Tracking" else "33"
        lines.append(
            f"{style('Current', '1', '36', enabled=enabled)} "
            f"{style(state_text, '1', state_color, enabled=enabled)}   "
            f"{style(session['duration_clock'], '1', enabled=enabled)}   "
            f"{session['project']}  |  {session['description']}"
        )

        lines.append("")

    border = style(table_border(widths), "90", enabled=enabled)
    if not entries:
        lines.append(border)
        lines.append(
            table_row(
                ["#", "DONE", "TIME", "DESCRIPTION", "WINDOW"],
                widths,
                enabled=enabled,
                cell_styles=[("1", "36"), ("1", "36"), ("1", "36"), ("1", "36"), ("1", "36")],
            )
        )
        lines.append(border)
        lines.append(
            table_row(
                [
                    "-",
                    "[ ]",
                    "0s",
                    "No tracked work today.",
                    "-",
                ],
                widths,
                enabled=enabled,
                cell_styles=[None, ("31",), ("1", "32"), ("90",), None],
            )
        )
        lines.append(border)
        return "\n".join(lines)

    for project_group in project_groups:
        task_count_label = f"{project_group['task_count']} tasks"
        checked_count_label = f"{project_group['checked_count']} done"
        lines.append(
            f"{style('Project', '1', '36', enabled=enabled)} "
            f"{style(project_group['project'], '1', '35', enabled=enabled)}   "
            f"{style(project_group['duration_label'], '1', '32', enabled=enabled)}   "
            f"{style(task_count_label, '90', enabled=enabled)}   "
            f"{style(checked_count_label, '90', enabled=enabled)}"
        )
        lines.append(border)
        lines.append(
            table_row(
                [
                    "#",
                    "DONE",
                    "TIME",
                    "DESCRIPTION",
                    "WINDOW",
                ],
                widths,
                enabled=enabled,
                cell_styles=[
                    ("1", "36"),
                    ("1", "36"),
                    ("1", "36"),
                    ("1", "36"),
                    ("1", "36"),
                ],
            )
        )
        lines.append(border)

        for entry in project_group["entries"]:
            checkbox = str(entry.get("checkbox", "[ ]"))
            is_checked = bool(entry.get("checked"))
            lines.append(
                table_row(
                    [
                        str(entry.get("entry_number", "")),
                        checkbox,
                        entry["duration_label"],
                        entry["description"],
                        entry.get("rounded_range_label", entry["range_label"]),
                    ],
                    widths,
                    enabled=enabled,
                    cell_styles=[
                        ("1", "90"),
                        ("1", "32") if is_checked else ("1", "31"),
                        ("1", "32"),
                        ("90",) if is_checked else None,
