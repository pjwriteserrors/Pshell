    def resolve_day_project(
        self,
        day_value: str | None,
        current_timestamp: int,
        *,
        project: str,
    ) -> tuple[str, dict[str, Any]]:
        day_payload = self.day_entries(day_value, current_timestamp)
        project_name = normalize_text(project)

        if not project_name:
            raise TrackerError("Project is required.")

        for project_group in day_payload["project_groups"]:
            if normalize_text(str(project_group["project"])) == project_name:
                return str(day_payload["day"]), dict(project_group)

        raise TrackerError(f"No project matched for {day_payload['day']}: {project_name}")

    def delete_day_project(
        self,
