    def remove_day_time(
        self,
        day_start_ts: int,
        day_end_ts: int,
        current_timestamp: int,
        *,
        project: str,
        description: str | None = None,
    ) -> dict[str, Any]:
        project = normalize_text(project)
        description = normalize_text(description) if description is not None else None

        if not project:
            raise TrackerError("Project is required.")
        if description is not None and not description:
            raise TrackerError("Description is required.")

        if description is None:
            rows = self.connection.execute(
                """
                SELECT
                    segments.id,
                    segments.session_id,
                    segments.started_ts,
                    segments.ended_ts,
                    sessions.state
                FROM segments
                JOIN sessions ON sessions.id = segments.session_id
                WHERE sessions.project = ?
                  AND segments.started_ts < ?
                  AND COALESCE(segments.ended_ts, ?) > ?
                ORDER BY segments.id ASC
                """,
                (project, day_end_ts, current_timestamp, day_start_ts),
            ).fetchall()
        else:
            rows = self.connection.execute(
                """
                SELECT
                    segments.id,
                    segments.session_id,
                    segments.started_ts,
                    segments.ended_ts,
                    sessions.state
                FROM segments
                JOIN sessions ON sessions.id = segments.session_id
                WHERE sessions.project = ?
                  AND sessions.description = ?
                  AND segments.started_ts < ?
                  AND COALESCE(segments.ended_ts, ?) > ?
                ORDER BY segments.id ASC
                """,
                (project, description, day_end_ts, current_timestamp, day_start_ts),
            ).fetchall()

        if not rows:
            raise TrackerError("No matching tracked time found to delete.")

        open_rows = [row for row in rows if row["ended_ts"] is None]
        rows = [row for row in rows if row["ended_ts"] is not None]

        if not rows:
            raise TrackerError("Stop the matching timer before deleting it.")

        affected_session_ids = {int(row["session_id"]) for row in rows}
        removed_seconds = 0
        deleted_segments = 0
        adjusted_segments = 0
        split_segments = 0
        deleted_sessions = 0

        with self.connection:
            for row in rows:
                segment_id = int(row["id"])
                session_id = int(row["session_id"])
                started_ts = int(row["started_ts"])
                ended_ts = int(row["ended_ts"])
                removed_seconds += max(
                    0,
                    min(day_end_ts, ended_ts) - max(day_start_ts, started_ts),
                )

                if started_ts >= day_start_ts and ended_ts <= day_end_ts:
                    self.connection.execute(
                        "DELETE FROM segments WHERE id = ?",
                        (segment_id,),
                    )
                    deleted_segments += 1
                elif started_ts < day_start_ts and ended_ts > day_end_ts:
                    self.connection.execute(
                        """
                        UPDATE segments
                        SET ended_ts = ?
                        WHERE id = ?
                        """,
                        (day_start_ts, segment_id),
                    )
                    self.connection.execute(
                        """
                        INSERT INTO segments (session_id, started_ts, ended_ts)
                        VALUES (?, ?, ?)
                        """,
                        (session_id, day_end_ts, ended_ts),
                    )
                    split_segments += 1
                elif started_ts < day_start_ts:
                    self.connection.execute(
                        """
                        UPDATE segments
                        SET ended_ts = ?
                        WHERE id = ?
                        """,
                        (day_start_ts, segment_id),
                    )
                    adjusted_segments += 1
                else:
                    self.connection.execute(
                        """
                        UPDATE segments
                        SET started_ts = ?
                        WHERE id = ?
                        """,
                        (day_end_ts, segment_id),
                    )
                    adjusted_segments += 1

            for session_id in affected_session_ids:
                bounds = self.connection.execute(
                    """
                    SELECT
                        COUNT(*) AS segment_count,
                        MIN(started_ts) AS first_started_ts,
                        MAX(ended_ts) AS last_ended_ts,
                        SUM(CASE WHEN ended_ts IS NULL THEN 1 ELSE 0 END) AS open_segment_count
                    FROM segments
                    WHERE session_id = ?
                    """,
                    (session_id,),
                ).fetchone()
                session = self.connection.execute(
                    """
                    SELECT state
                    FROM sessions
                    WHERE id = ?
                    """,
                    (session_id,),
                ).fetchone()

                if int(bounds["segment_count"]) == 0:
                    self.connection.execute(
                        "DELETE FROM sessions WHERE id = ?",
                        (session_id,),
                    )
                    deleted_sessions += 1
                elif int(bounds["open_segment_count"] or 0) > 0:
                    self.connection.execute(
                        """
                        UPDATE sessions
                        SET started_ts = ?,
                            updated_ts = ?
                        WHERE id = ?
                        """,
                        (
                            int(bounds["first_started_ts"]),
                            current_timestamp,
                            session_id,
                        ),
                    )
                elif session and str(session["state"]) == "paused":
                    self.connection.execute(
                        """
                        UPDATE sessions
                        SET started_ts = ?,
                            paused_ts = ?,
                            updated_ts = ?
                        WHERE id = ?
                        """,
                        (
                            int(bounds["first_started_ts"]),
                            int(bounds["last_ended_ts"]),
                            current_timestamp,
                            session_id,
                        ),
                    )
                else:
                    self.connection.execute(
                        """
                        UPDATE sessions
                        SET started_ts = ?,
                            stopped_ts = ?,
                            updated_ts = ?
                        WHERE id = ?
                        """,
                        (
                            int(bounds["first_started_ts"]),
                            int(bounds["last_ended_ts"]),
                            current_timestamp,
                            session_id,
                        ),
                    )

        return {
            "removed_seconds": removed_seconds,
            "removed_label": format_duration(removed_seconds, include_seconds=False),
            "deleted_segments": deleted_segments,
            "adjusted_segments": adjusted_segments,
            "split_segments": split_segments,
            "deleted_sessions": deleted_sessions,
            "skipped_open_segments": len(open_rows),
        }

