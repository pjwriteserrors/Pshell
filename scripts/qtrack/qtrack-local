    teamwork_tasks_parser = subparsers.add_parser("teamwork-tasks", help="Return open Teamwork tasks that are assigned to, mention or were tracked by the authenticated user.")
    teamwork_tasks_parser.add_argument("--json", action="store_true")

    sync_teamwork_parser = subparsers.add_parser("sync-teamwork", help="Create Teamwork timelogs for checked day entries.")
    sync_teamwork_parser.add_argument("--day", default="today")
    sync_teamwork_parser.add_argument("--json", action="store_true")

    assign_teamwork_parser = subparsers.add_parser("assign-teamwork", help="Assign a day entry to a Teamwork task before syncing.")
    assign_teamwork_parser.add_argument("entry", nargs="?", type=int, help="Entry number from `qtrack today` or `qtrack report`.")
    assign_teamwork_parser.add_argument("--day", default="today")
    assign_teamwork_parser.add_argument("--project")
    assign_teamwork_parser.add_argument("--description")
    assign_teamwork_parser.add_argument("--teamwork-task-id", required=True, type=int)
    assign_teamwork_parser.add_argument("--teamwork-project-id", required=True, type=int)
    assign_teamwork_parser.add_argument("--teamwork-task-name", default="")
    assign_teamwork_parser.add_argument("--teamwork-project-name", default="")
