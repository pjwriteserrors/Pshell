            )

        lines.append(border)
        lines.append("")

    lines.append("")
    lines.append(
        f"{style('Mark entered:', '1', '36', enabled=enabled)} {APP_NAME} check <#>   "
        f"{style('Undo:', '1', '36', enabled=enabled)} {APP_NAME} uncheck <#>   "
        f"{style('Toggle:', '1', '36', enabled=enabled)} {APP_NAME} toggle <#>   "
        f"{style('Delete:', '1', '36', enabled=enabled)} {APP_NAME} delete <#>"
    )
    return "\n".join(lines)


