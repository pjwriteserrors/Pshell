+        // Sample colors 0-5 that we will use. Deduplication can legitimately
+        // leave fewer than six histogram entries for low-colour images. The
+        // palette still needs six slots, so repeat the real samples instead of
+        // indexing beyond the end of the vector.
+        let sampled: Vec<Srgb> = match mode {
+            SamplingMode::Low         => cols.clone(),
+            SamplingMode::Balanced    => util::sample_center(&cols, 6),
+            SamplingMode::Distributed => util::sample_distributed(&cols, 6),
+            SamplingMode::High        => cols[cols.len().saturating_sub(6)..].to_vec(),
+        };
+        let c: Vec<Srgb> = sampled.iter().copied().cycle().take(6).collect();
