{
	"primaryOutput": "DP-2",
	"weather": {
		"city": "Paderborn"
	},
	"wallpapers": "~/Pictures/Wallpapers",
	"plugins": {
		"backlight": true,
		"ddc": true,
		"power-profiles": true,
		"battery": true,
		"mouse-battery": true,
		"fingerprint": true,
		"kdeconnect": true,
		"haptics": true,
		"ssh": true,
		"niri-settings": true,
		"qtrack": true,
		"notes": true,
		"todos": true,
		"rpg": true,
		"microsoft-calendar": true
	},
	"themeHooks": [
		"sddm",
		"obsidian",
		"spicetify",
		"kitty",
		"pywalfox"
	],
	"hookConfig": {
		"spicetify": {
			"generator": "~/.config/spicetify/Themes/custom/generate.py"
		}
	}
}
