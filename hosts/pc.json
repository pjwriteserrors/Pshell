{
	"terminal": "kitty",
	"browser": "floorp",
	"primaryOutput": "DP-2",
	"weather": {
		"city": "Paderborn"
	},
	"wallpapers": "~/Scripts/themes/color_themes",
	"plugins": {
		"ddc": true,
		"mouse-battery": true,
		"phone": true,
		"haptics": true,
		"mouse": true,
		"vm-launcher": true,
		"games": true,
		"watch": true
	},
	"themeHooks": [
		"sddm",
		"betterdiscord",
		"obsidian",
		"spicetify",
		"steam",
		"kitty",
		"pywalfox",
		"telegram",
		"oomox",
		"openrgb",
		"openrgb-leds"
	],
	"hookConfig": {
		"spicetify": {
			"generator": "~/Scripts/themes/changer/spicetify_maker.py",
			"refresh": true
		},
		"steam": {
			"script": "~/Scripts/themes/changer/update_steam_theme.py"
		}
	}
}
