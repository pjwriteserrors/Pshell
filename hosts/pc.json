{
	"primaryOutput": "DP-2",
	"weather": {
		"city": "Paderborn"
	},
	"wallpapers": "~/Scripts/themes/color_themes",
	"plugins": {
		"ddc": true,
		"mouse-battery": true,
		"kdeconnect": true,
		"haptics": true
	},
	"themeHooks": [
		"sddm",
		"betterdiscord",
		"obsidian",
		"spicetify",
		"steam",
		"kitty",
		"pywalfox",
		"telegram",
		"oomox",
		"openrgb"
	],
	"hookConfig": {
		"spicetify": {
			"generator": "~/Scripts/themes/changer/spicetify_maker.py",
			"refresh": true
		},
		"steam": {
			"script": "~/Scripts/themes/changer/update_steam_theme.py"
		}
	}
}
