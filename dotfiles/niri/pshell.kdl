// The shell's part of the niri config. Linked to ~/.config/niri/pshell.kdl
// by install.sh and pulled in with `include "pshell.kdl"`; everything that
// differs per machine (outputs, input, window rules) stays in config.kdl.

// the gtk3 platform theme (or Qt ignores the GTK icon theme) and only the
// EGL of the GPU that draws: scripts/start_shell.sh
spawn-sh-at-startup "~/.config/quickshell/shell/scripts/start_shell.sh"

// games through Steam and Proton open fullscreen (Proton names their window
// steam_app_<id>); scripts/games_guard.py also keeps Wine and Linux games
// fullscreen and those that leave it while they start
// a stream or an episode in a small window (Streams, picture in picture)
window-rule {
    match app-id="pshell-streams-pip"
    open-floating true
    open-focused false
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
    default-floating-position x=24 y=24 relative-to="bottom-right"
}

window-rule {
    match app-id=r#"^steam_app_\d+$"#
    open-fullscreen true
}

// every app's file chooser (Pshell Files, core/views/files/ChooserWindow.qml)
// floats over the app like a dialog
window-rule {
    match app-id=r#"quickshell"# title=r#"^File chooser|^Open with$"#
    open-floating true
    open-focused true
}

// the shell's pictures (core/views/viewer/ViewerWindow.qml) float in the
// middle of the screen like a lightbox
window-rule {
    match app-id=r#"quickshell"# title=r#" – Pictures$|^Pictures$"#
    open-floating true
    open-focused true
}

// the shell's music (core/views/music/MusicWindow.qml) floats too; made
// small (M) it is a strip that can sit in a corner
window-rule {
    match app-id=r#"quickshell"# title=r#" – Music$|^Music$"#
    open-floating true
    open-focused true
}

// the shell's videos (core/views/video/VideoWindow.qml) float as well; picture
// in picture is the same window made small in a corner
window-rule {
    match app-id=r#"quickshell"# title=r#" – Video$|^Video$"#
    open-floating true
    open-focused true
}

// the shell's AppImage installer (core/views/appimages/AppImagesWindow.qml)
// floats like a dialog
window-rule {
    match app-id=r#"quickshell"# title=r#"^AppImages$"#
    open-floating true
    open-focused true
}

// the shell's PDFs (core/views/pdf/PdfWindow.qml) float too; slides are the
// same window made fullscreen
window-rule {
    match app-id=r#"quickshell"# title=r#" – PDF$|^PDF$"#
    open-floating true
    open-focused true
}

// the shell's copy of the wallpaper for the overview and the gaps between
// workspaces (core/views/overlays/WallpaperLayer.qml, backdrop)
layer-rule {
    match namespace="^shell-wallpaper-backdrop$"
    place-within-backdrop true
}

window-rule {
    match app-id="de.pshell.Editor" title="Pshell Scratchpad"
    open-floating true
    open-focused true
    default-column-width { fixed 720; }
    default-window-height { fixed 520; }
}

binds {
    Mod+Alt+N { spawn "qs" "-c" "shell" "ipc" "call" "editor" "scratch"; }
    Mod+D { spawn "qs" "-c" "shell" "ipc" "call" "launcher" "toggle"; }
    Ctrl+Shift+Escape { spawn "qs" "-c" "shell" "ipc" "call" "taskmgr" "toggle"; }
    Super+Ctrl+L { spawn "qs" "-c" "shell" "ipc" "call" "lock" "lock"; }
    Ctrl+Mod+V { spawn "qs" "-c" "shell" "ipc" "call" "clipboard" "toggle"; }
    Mod+X { spawn "qs" "-c" "shell" "ipc" "call" "radial" "toggle"; }
    Mod+A { spawn "qs" "-c" "shell" "ipc" "call" "shelf" "toggle"; }
    Mod+Shift+A { spawn "qs" "-c" "shell" "ipc" "call" "shelf" "clipboard"; }
    Mod+Shift+S { spawn "qs" "-c" "shell" "ipc" "call" "studio" "toggle" ""; }
    Mod+Alt+L { spawn "qs" "-c" "shell" "ipc" "call" "laser" "toggle"; }
    Ctrl+Alt+Delete { spawn "qs" "-c" "shell" "ipc" "call" "power" "open"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "qs" "-c" "shell" "ipc" "call" "volume" "raise"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "qs" "-c" "shell" "ipc" "call" "volume" "lower"; }
    XF86AudioMute allow-when-locked=true { spawn "qs" "-c" "shell" "ipc" "call" "volume" "muteToggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "qs" "-c" "shell" "ipc" "call" "volume" "micMuteToggle"; }
    // the laptop panel and DDC monitors, whichever the host has
    XF86MonBrightnessUp allow-when-locked=true cooldown-ms=250 { spawn "qs" "-c" "shell" "ipc" "call" "brightness" "raise"; }
    XF86MonBrightnessDown allow-when-locked=true cooldown-ms=250 { spawn "qs" "-c" "shell" "ipc" "call" "brightness" "lower"; }

    Ctrl+Mod+S { spawn "qs" "-c" "shell" "ipc" "call" "screenshot" "region"; }
    Ctrl+Mod+R { spawn-sh "~/.local/bin/record"; }

    // the browser (docs/browser.md, plugins browser-*)
    Mod+B { spawn "qs" "-c" "shell" "ipc" "call" "browser" "search" ""; }
    Mod+Shift+M { spawn "qs" "-c" "shell" "ipc" "call" "browser" "muteActive"; }
    Mod+Alt+Page_Down { spawn "qs" "-c" "shell" "ipc" "call" "browser" "workspace" "next"; }
    Mod+Alt+Page_Up { spawn "qs" "-c" "shell" "ipc" "call" "browser" "workspace" "previous"; }
    Mod+Shift+Print { spawn "qs" "-c" "shell" "ipc" "call" "browser" "capturePage" "full"; }
}
