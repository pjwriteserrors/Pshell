#!/usr/bin/env bash
# Toggle a region recording. The shell shows a live indicator in the bar
# while wf-recorder runs and a toast with the file when it is done.

ipc="$(dirname -- "$(readlink -f -- "$0")")/../../scripts/ipc.sh"

if pgrep -x wf-recorder >/dev/null; then
  pkill -INT -x wf-recorder
  exit 0
fi

geom="$(slurp)" || exit 0

dir="$(xdg-user-dir VIDEOS 2>/dev/null || echo "$HOME/Videos")/Recordings"
mkdir -p "$dir"
file="$dir/Recording_$(date +%Y-%m-%d_%H-%M-%S).mp4"

"$ipc" recording started "$file" >/dev/null 2>&1
wf-recorder -g "$geom" -f "$file" >/dev/null 2>&1
"$ipc" recording stopped "$file" >/dev/null 2>&1
