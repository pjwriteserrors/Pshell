{
	"manifest_version": 2,
	"name": "Pshell YouTube Resume",
	"version": "1.0",
	"description": "Remembers how far every YouTube video was watched and starts it there again, in any tab; keeps the video tabs that were open when the browser closed.",
	"browser_specific_settings": {
		"gecko": { "id": "youtube-resume@pshell", "strict_min_version": "115.0" }
	},
	"permissions": ["storage", "tabs"],
	"background": { "scripts": ["background.js"], "persistent": true },
	"content_scripts": [{
		"matches": ["*://*.youtube.com/*", "*://*.youtube-nocookie.com/*"],
		"js": ["content.js"],
		"run_at": "document_start",
		"all_frames": true
	}],
	"browser_action": {
		"default_title": "Continue watching",
		"default_popup": "popup.html",
		"default_icon": "icon.svg"
	},
	"icons": { "48": "icon.svg", "96": "icon.svg" }
}
