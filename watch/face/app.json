{
  "configVersion": "v3",
  "app": {
    "appId": 1073745,
    "appName": "PShell Face",
    "appType": "watchface",
    "version": {
      "code": 9,
      "name": "1.3.5"
    },
    "icon": "icon.png",
    "vender": "pshell",
    "description": "The shell's look on the wrist in its wallust colours: the time, the day, last night's sleep; it hands the watch's health data to the PC now and then"
  },
  "permissions": [
    "data:user.hd.step",
    "data:user.hd.heart_rate",
    "data:user.hd.sleep",
    "data:user.hd.stress",
    "data:user.hd.spo",
    "data:user.hd.calorie",
    "data:user.hd.distance",
    "data:user.hd.stand",
    "data:user.hd.fat_burning",
    "data:user.hd.pai",
    "data:user.hd.body_temp",
    "data:os.device.info",
    "device:os.ble",
    "device:os.local_storage",
    "device:os.accelerometer"
  ],
  "runtime": {
    "apiVersion": {
      "compatible": "3.0",
      "target": "4.0",
      "minVersion": "3.0"
    }
  },
  "targets": {
    "default": {
      "module": {
        "watchface": {
          "path": "watchface/index",
          "main": 1,
          "editable": 0,
          "lockscreen": 0,
          "hightCost": 0
        }
      },
      "platforms": [
        {
          "deviceSource": 10223872
        },
        {
          "deviceSource": 10223873
        },
        {
          "deviceSource": 10223875
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "PShell Face"
    },
    "de-DE": {
      "appName": "PShell Face"
    }
  },
  "defaultLanguage": "en-US",
  "designWidth": 390
}
